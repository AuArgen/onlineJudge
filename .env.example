APP_NAME="Online Judge"
APP_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── DATABASE (тышкы PostgreSQL) ─────────────────────────────────────────────
# Туташуу үчүн тышкы PostgreSQL серверинин маалыматтарын жазыңыз.
# DB_HOST мисалдары:
#   localhost         — ушул машинадагы Postgres
#   192.168.1.100     — LAN'дагы сервер
#   db.example.com    — remote сервер
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=onlinejudge
DB_SSLMODE=disable

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── SECURITY ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_string_in_production
ADMIN_EMAIL=admin@example.com
ALLOWED_ORIGINS=http://localhost:3000
